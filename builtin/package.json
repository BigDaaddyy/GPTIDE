{
  "name": "gptide-chat",
  "displayName": "GptIDE 内置聊天",
  "publisher": "gptide",
  "version": "0.23.0",
  "engines": {
    "vscode": "^1.100.0"
  },
  "main": "./extension.cjs",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": {
      "supported": false
    }
  },
  "activationEvents": [
    "onStartupFinished",
    "onCommand:gptide.homeOpenRecent",
    "onCommand:gptide.homeAccount",
    "onCommand:gptide.homeSSH",
    "onCommand:gptide.homeError"
  ],
  "contributes": {
    "commands": [
      {
        "command": "gptide.accountInfo",
        "title": "GPT 账户状态"
      },
      {
        "command": "gptide.accountLogin",
        "title": "GPT 账户: 登录 / 切换 ChatGPT 账户"
      },
      {
        "command": "gptide.importVSCode",
        "title": "GptIDE: 导入 VS Code 设置和插件"
      },
      {
        "command": "gptide.open",
        "title": "GptIDE: 打开 AI 聊天",
        "enablement": "workspaceFolderCount == 1"
      },
      {
        "command": "gptide.login",
        "title": "GptIDE: 使用 ChatGPT 登录",
        "enablement": "workspaceFolderCount == 1"
      },
      {
        "command": "gptide.refresh",
        "title": "GptIDE: 重新读取项目进度",
        "enablement": "workspaceFolderCount == 1"
      },
      {
        "command": "gptide.attachSelection",
        "title": "GptIDE: 引用当前代码",
        "enablement": "workspaceFolderCount == 1"
      },
      {
        "command": "gptide.inlineEdit",
        "title": "GptIDE: 改写选中代码（Ctrl+K）",
        "enablement": "workspaceFolderCount == 1"
      },
      {
        "command": "gptide.newChat",
        "title": "GptIDE: 新建对话",
        "enablement": "workspaceFolderCount == 1"
      },
      {
        "command": "gptide.usage",
        "title": "GptIDE: 快速查看用量"
      },
      {
        "command": "gptide.settings",
        "title": "GptIDE: 会话与 Codex 配置"
      },
      {
        "command": "gptide.diagnostics",
        "title": "GptIDE: 本机诊断"
      },
      {
        "command": "gptide.attachDiagnostics",
        "title": "GptIDE: 引用项目诊断",
        "enablement": "workspaceFolderCount == 1"
      },
      {
        "command": "gptide.attachGitDiff",
        "title": "GptIDE: 引用 Git 差异",
        "enablement": "workspaceFolderCount == 1"
      },
      {
        "command": "gptide.attachFolder",
        "title": "GptIDE: 引用文件夹",
        "enablement": "workspaceFolderCount == 1"
      },
      {
        "command": "gptide.exportChat",
        "title": "GptIDE: 导出当前项目对话",
        "enablement": "workspaceFolderCount == 1"
      },
      {
        "command": "gptide.cleanupCheckpoints",
        "title": "GptIDE: 清理未引用的检查点缓存",
        "enablement": "workspaceFolderCount == 1"
      }
    ],
    "keybindings": [
      {
        "command": "gptide.open",
        "key": "ctrl+l",
        "when": "workspaceFolderCount == 1"
      },
      {
        "command": "gptide.inlineEdit",
        "key": "ctrl+k",
        "when": "editorTextFocus && workspaceFolderCount == 1"
      },
      {
        "command": "gptide.attachSelection",
        "key": "ctrl+shift+k",
        "when": "editorTextFocus && workspaceFolderCount == 1"
      },
      {
        "command": "gptide.newChat",
        "key": "ctrl+shift+l",
        "when": "workspaceFolderCount == 1"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "gptide.inlineEdit",
          "group": "gptide@1"
        },
        {
          "command": "gptide.attachSelection",
          "group": "gptide@2"
        }
      ],
      "commandPalette": [
        {
          "command": "gptide.accountInfo",
          "when": "false"
        },
        {
          "command": "gptide.open",
          "when": "workspaceFolderCount == 1"
        },
        {
          "command": "gptide.login",
          "when": "workspaceFolderCount == 1"
        },
        {
          "command": "gptide.refresh",
          "when": "workspaceFolderCount == 1"
        },
        {
          "command": "gptide.attachSelection",
          "when": "workspaceFolderCount == 1"
        },
        {
          "command": "gptide.inlineEdit",
          "when": "workspaceFolderCount == 1"
        },
        {
          "command": "gptide.newChat",
          "when": "workspaceFolderCount == 1"
        },
        {
          "command": "gptide.attachDiagnostics",
          "when": "workspaceFolderCount == 1"
        },
        {
          "command": "gptide.attachGitDiff",
          "when": "workspaceFolderCount == 1"
        },
        {
          "command": "gptide.attachFolder",
          "when": "workspaceFolderCount == 1"
        },
        {
          "command": "gptide.exportChat",
          "when": "workspaceFolderCount == 1"
        },
        {
          "command": "gptide.cleanupCheckpoints",
          "when": "workspaceFolderCount == 1"
        }
      ],
      "explorer/context": [
        {
          "command": "gptide.attachFolder",
          "when": "explorerResourceIsFolder && workspaceFolderCount == 1",
          "group": "gptide@1"
        }
      ]
    },
    "viewsContainers": {
      "secondarySidebar": [
        {
          "id": "gptide",
          "title": "GptIDE",
          "icon": "icon.svg"
        }
      ]
    },
    "views": {
      "gptide": [
        {
          "id": "gptide.chat",
          "name": "Agent",
          "type": "webview",
          "when": "workspaceFolderCount == 1"
        }
      ]
    },
    "configuration": {
      "title": "GptIDE",
      "properties": {
        "gptide.codexPath": {
          "type": "string",
          "default": "",
          "description": "可选：Codex 可执行文件位置。"
        },
        "gptide.cursorUserPath": {
          "type": "string",
          "default": "",
          "description": "可选：Cursor/User 数据目录。默认自动检测。"
        },
        "gptide.model": {
          "type": "string",
          "default": "gpt-6.1-sol",
          "description": "首选模型。只使用会员登录。"
        },
        "gptide.connection.autoConnect": {
          "type": "boolean",
          "default": true,
          "description": "打开项目后自动连接；关闭后仅发送或登录时连接。"
        },
        "gptide.connection.timeoutSeconds": {
          "type": "number",
          "default": 45,
          "minimum": 10,
          "maximum": 180,
          "description": "后端请求超时秒数，新连接生效。"
        },
        "gptide.approvalPolicy": {
          "type": "string",
          "enum": [
            "on-request",
            "untrusted",
            "never"
          ],
          "default": "on-request",
          "description": "授权策略；never 在现有沙箱权限内执行，越界请求拒绝。"
        },
        "gptide.agent.networkAccess": {
          "type": "boolean",
          "default": false,
          "description": "Agent 工作区沙箱网络权限。"
        },
        "gptide.defaultMode": {
          "type": "string",
          "enum": [
            "agent",
            "ask",
            "plan"
          ],
          "default": "agent",
          "description": "新项目默认工作模式。"
        },
        "gptide.reasoningEffort": {
          "type": "string",
          "enum": [
            "minimal",
            "low",
            "medium",
            "high",
            "xhigh",
            "max",
            "ultra"
          ],
          "default": "medium",
          "description": "新项目默认推理强度；以模型支持范围为准。"
        },
        "gptide.chat.submitKey": {
          "type": "string",
          "enum": [
            "enter",
            "ctrlEnter"
          ],
          "default": "enter",
          "description": "消息发送快捷键。"
        },
        "gptide.context.importLimit": {
          "type": "number",
          "default": 180000,
          "minimum": 20000,
          "maximum": 300000,
          "description": "导入 Cursor 背景最大字符数，原始记录保留。"
        },
        "gptide.usage.showStatusBar": {
          "type": "boolean",
          "default": true,
          "description": "在状态栏显示本机缓存用量。"
        },
        "gptide.usage.autoRefreshSeconds": {
          "type": "number",
          "default": 60,
          "enum": [
            0,
            30,
            60,
            120,
            300,
            600
          ],
          "description": "定期读取本机用量记录的间隔；0 关闭定期读取，不发起模型请求。"
        },
        "gptide.usage.staleAfterMinutes": {
          "type": "number",
          "default": 15,
          "minimum": 1,
          "maximum": 240,
          "description": "缓存超过该分钟数或窗口已过期时，不在状态栏显示剩余百分比。"
        },
        "gptide.review.maxCheckpoints": {
          "type": "number",
          "default": 20,
          "minimum": 1,
          "maximum": 50,
          "description": "每个对话保留的改动检查点数量。"
        },
        "gptide.review.storageLimitMb": {
          "type": "number",
          "default": 128,
          "minimum": 32,
          "maximum": 512,
          "description": "每项目检查点内容缓存上限，MiB。"
        }
      }
    }
  }
}
