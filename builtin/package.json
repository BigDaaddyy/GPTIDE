{
  "name": "gptide-chat",
  "displayName": "GptIDE 内置聊天",
  "publisher": "gptide",
  "version": "0.9.0",
  "engines": {
    "vscode": "^1.100.0"
  },
  "main": "./extension.cjs",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": {
      "supported": false
    }
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "gptide.importVSCode",
        "title": "GptIDE: 导入 VS Code 设置和插件"
      },
      {
        "command": "gptide.open",
        "title": "GptIDE: 打开 AI 聊天",
        "enablement": "workspaceFolderCount == 1"
      },
      {
        "command": "gptide.login",
        "title": "GptIDE: 使用 ChatGPT 登录",
        "enablement": "workspaceFolderCount == 1"
      },
      {
        "command": "gptide.refresh",
        "title": "GptIDE: 重新读取项目进度",
        "enablement": "workspaceFolderCount == 1"
      },
      {
        "command": "gptide.attachSelection",
        "title": "GptIDE: 引用当前代码",
        "enablement": "workspaceFolderCount == 1"
      },
      {
        "command": "gptide.inlineEdit",
        "title": "GptIDE: 改写选中代码（Ctrl+K）",
        "enablement": "workspaceFolderCount == 1"
      },
      {
        "command": "gptide.newChat",
        "title": "GptIDE: 新建对话",
        "enablement": "workspaceFolderCount == 1"
      }
    ],
    "keybindings": [
      {
        "command": "gptide.open",
        "key": "ctrl+l",
        "when": "workspaceFolderCount == 1"
      },
      {
        "command": "gptide.inlineEdit",
        "key": "ctrl+k",
        "when": "editorTextFocus && workspaceFolderCount == 1"
      },
      {
        "command": "gptide.attachSelection",
        "key": "ctrl+shift+k",
        "when": "editorTextFocus && workspaceFolderCount == 1"
      },
      {
        "command": "gptide.newChat",
        "key": "ctrl+shift+l",
        "when": "workspaceFolderCount == 1"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "gptide.inlineEdit",
          "group": "gptide@1"
        },
        {
          "command": "gptide.attachSelection",
          "group": "gptide@2"
        }
      ],
      "commandPalette": [
        {
          "command": "gptide.open",
          "when": "workspaceFolderCount == 1"
        },
        {
          "command": "gptide.login",
          "when": "workspaceFolderCount == 1"
        },
        {
          "command": "gptide.refresh",
          "when": "workspaceFolderCount == 1"
        },
        {
          "command": "gptide.attachSelection",
          "when": "workspaceFolderCount == 1"
        },
        {
          "command": "gptide.inlineEdit",
          "when": "workspaceFolderCount == 1"
        },
        {
          "command": "gptide.newChat",
          "when": "workspaceFolderCount == 1"
        }
      ]
    },
    "viewsContainers": {
      "secondarySidebar": [
        {
          "id": "gptide",
          "title": "GptIDE",
          "icon": "icon.svg"
        }
      ]
    },
    "views": {
      "gptide": [
        {
          "id": "gptide.chat",
          "name": "Agent",
          "type": "webview",
          "when": "workspaceFolderCount == 1"
        }
      ]
    },
    "configuration": {
      "title": "GptIDE",
      "properties": {
        "gptide.codexPath": {
          "type": "string",
          "default": "",
          "description": "可选：Codex 可执行文件位置。"
        },
        "gptide.cursorUserPath": {
          "type": "string",
          "default": "",
          "description": "可选：Cursor/User 数据目录。默认自动检测。"
        },
        "gptide.model": {
          "type": "string",
          "default": "gpt-6.1-sol",
          "description": "首选模型。只使用会员登录。"
        }
      }
    }
  }
}
